# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/

# Run artefacts. runs/ is a working directory — LoRA adapters, a ~63 MB head bundle, ~1.2 GB
# of AdamW moments and resume metadata rewritten every checkpoint. None of it belongs in a
# public reference, and train.py creates the directory on demand, so there is nothing to
# commit to hold its place.
runs/

# wandb's local mirror. Everything needed to reproduce a run is in the committed config and
# the run's own log; this is just the local upload spool.
wandb/

# macOS
.DS_Store

# Keep the directory, not its contents
!logs/.gitkeep
